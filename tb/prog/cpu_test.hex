// === CSR 指令自测（Zicsr 六种形式 + misa 只读）===
00001c37    // 0x48c  lui  x24, 0x00001      x24 = 0x1234
234c0c13    // 0x490  addi x24, x24, 564   x24 = 0x1234
340c1cf3    // 0x494  csrrw x25, mscratch, x24  写 0x1234，x25=旧值
2192a023    // 0x498  sw   x25, 0x200  csrrw 读到旧值
34002c73    // 0x49c  csrrs x24, mscratch, x0   读回 0x1234（不写）
2182a223    // 0x4a0  sw   x24, 0x204  csrrs 读回值
340fdd73    // 0x4a4  csrrwi x26, mscratch, 31  mscratch=31，x26=旧值
21a2a423    // 0x4a8  sw   x26, 0x208  csrrwi 读到旧值
30102ef3    // 0x4ac  csrrs x29, misa, x0      misa 只读
21d2a623    // 0x4b0  sw   x29, 0x20c  misa 只读值
340c3f73    // 0x4b4  csrrc x30, mscratch, x24  mscratch &= ~x24，x30=旧值
21e2a823    // 0x4b8  sw   x30, 0x210  csrrc 读到旧值
3400ee73    // 0x4bc  csrrsi x28, mscratch, 1   mscratch |= 1，x28=旧值
21c2aa23    // 0x4c0  sw   x28, 0x214  csrrsi 读到旧值
3400fdf3    // 0x4c4  csrrci x27, mscratch, 1   mscratch &= ~1，x27=旧值
21b2ac23    // 0x4c8  sw   x27, 0x218  csrrci 读到旧值
34002e73    // 0x4cc  csrrs x28, mscratch, x0   读回最终值
21c2ae23    // 0x4d0  sw   x28, 0x21c  mscratch 最终值
34102d73    // 0x4d4  csrrs x26, mepc, x0      mepc 复位值
23a2a023    // 0x4d8  sw   x26, 0x220  mepc 复位值
34001073    // 0x4dc  csrrw x0, mscratch, x0   清 mscratch

// === 异常：ECALL / EBREAK / 非法指令 / 非对齐访存 ===
00000b93    // 0x4e0  addi x23, x0, 0
240b8b93    // 0x4e4  addi x23, x23, 576   记录指针 = 陷阱记录区
2972a023    // 0x4e8  sw   x23, TRAP_PTR
00000b93    // 0x4ec  addi x23, x0, 0
2972a223    // 0x4f0  sw   x23, IRQ_FLAG   清中断标志
55800c13    // 0x4f4  addi x24, x0, 1368          mtvec = 处理程序入口
00000013    // 0x4f8  nop                     （地址小于 0x1000，无需 lui）
305c1073    // 0x4fc  csrrw x0, mtvec, x24  设置陷阱向量
00000073    // 0x500  ecall                  ★ 陷阱 1：mcause=11
00100073    // 0x504  ebreak                 ★ 陷阱 2：mcause=3
00000000    // 0x508  ? 非法指令 0x0000_0000  ★ 陷阱 3：mcause=2
0022ac83    // 0x50c  lw   x25, 2(x5)       ★ 陷阱 4：load 非对齐 mcause=4
0192a123    // 0x510  sw   x25, 2(x5)       ★ 陷阱 5：store 非对齐 mcause=6

// === 定时器中断 ===
20000c37    // 0x514  lui  x24, 0x20000      TIMER 基址
00500c93    // 0x518  addi x25, x0, 5       很短的重载值
019c2023    // 0x51c  sw   x25, 0(x24)      TIMER.LOAD = 5
00300c93    // 0x520  addi x25, x0, 3      EN | IRQ_EN
019c2423    // 0x524  sw   x25, 8(x24)      TIMER.CTRL = 3
08000c13    // 0x528  addi x24, x0, 0x80    mie.MTIE
304c1073    // 0x52c  csrrw x0, mie, x24    开定时器中断
00800c13    // 0x530  addi x24, x0, 8       mstatus.MIE
300c1073    // 0x534  csrrw x0, mstatus, x24 开全局中断
2842ac83    // 0x538  lw   x25, IRQ_FLAG    查询中断标志
fe0c8ee3    // 0x53c  beq  x25, x0, irq_loop  ← 中断在这里被受理
30001073    // 0x540  csrrw x0, mstatus, x0 关中断
20000c37    // 0x544  lui  x24, 0x20000      TIMER 基址
000c2423    // 0x548  sw   x0, 8(x24)       TIMER.CTRL = 0
00100c93    // 0x54c  addi x25, x0, 1
019c2623    // 0x550  sw   x25, 0x0C(x24)   STATUS 写 1 清溢出
0500006f    // 0x554  jal  x0, trap_done     跳过陷阱处理程序
340e9ef3    // 0x558  csrrw x29, mscratch, x29  保存 x29
34202e73    // 0x55c  csrrs x28, mcause, x0      x28 = mcause
34102df3    // 0x560  csrrs x27, mepc, x0        x27 = mepc
2802ad03    // 0x564  lw   x26, TRAP_PTR
01cd2023    // 0x568  sw   x28, 0(x26)          记录 mcause
01bd2223    // 0x56c  sw   x27, 4(x26)          记录 mepc
008d0d13    // 0x570  addi x26, x26, 8
29a2a023    // 0x574  sw   x26, TRAP_PTR        指针 +8
000e5e63    // 0x578  bge  x28, x0, h_sync      非负（同步异常）→ h_sync；否则中断路径
00100d13    // 0x57c  addi x26, x0, 1
29a2a223    // 0x580  sw   x26, IRQ_FLAG        置中断标志
20000d37    // 0x584  lui  x26, 0x20000      TIMER 基址
00100d93    // 0x588  addi x27, x0, 1
01bd2623    // 0x58c  sw   x27, 0x0C(x26)      STATUS 写 1 清溢出
00c0006f    // 0x590  jal  x0, h_ret
004d8d93    // 0x594  addi x27, x27, 4          跳过出错指令
341d9073    // 0x598  csrrw x0, mepc, x27
340e9ef3    // 0x59c  csrrw x29, mscratch, x29  恢复 x29
30200073    // 0x5a0  mret

